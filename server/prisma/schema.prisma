// Prisma Schema - 小象日志数据库
// 使用 SQLite 作为 MVP 阶段数据库，可通过修改 datasource 迁移到 PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// 1. 用户表
// ============================================
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  nickname     String
  passwordHash String   @map("password_hash")
  avatarUrl    String?  @map("avatar_url")
  bio          String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // 关联
  entries       DiaryEntry[]
  templates     DiaryTemplate[]
  editHistories EditHistory[]
  chatSessions  ChatSession[]
  customFonts   CustomFont[]
  posts         CommunityPost[]
  postLikes     PostLike[]
  postComments  PostComment[]
  postCommentLikes PostCommentLike[]
  customThemes  CustomTheme[]

  // 排行榜点赞
  receivedLeaderboardLikes LeaderboardLike[] @relation("ReceivedLeaderboardLikes")
  givenLeaderboardLikes    LeaderboardLike[] @relation("GivenLeaderboardLikes")

  // 好友关系（作为发起者）
  sentRequests     Friendship[] @relation("Requester")
  // 好友关系（作为接收者）
  receivedRequests Friendship[] @relation("Addressee")

  // 通知（作为接收者）
  notifications     Notification[] @relation("NotifReceiver")
  // 通知（作为发送者）
  sentNotifications Notification[] @relation("NotifSender")
  pushSubscriptions PushSubscription[]
  notificationPreference NotificationPreference?
  dailyTraceNodes DailyTraceNode[]
  monthlyArcDrafts MonthlyArcDraft[]
  monthlyEchoes MonthlyEcho[]
  monthlyEchoJobLogs MonthlyEchoJobLog[]
  dailyEchoJobs DailyEchoJob[]
  externalIdentities ExternalIdentity[]

  @@map("users")
}

// ============================================
// 1.1 外部登录身份（第一版仅微信）
// ============================================
model ExternalIdentity {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  provider         String
  appId            String   @map("app_id")
  openId           String   @map("open_id")
  unionId          String?  @map("union_id")
  providerUnionKey String?  @unique @map("provider_union_key")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  lastLoginAt      DateTime @default(now()) @map("last_login_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, appId, openId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("external_identities")
}

// 微信首次授权后、完成邮箱注册前的一次性短期凭证。
// 客户端只持有原始 token，数据库仅保存 token 哈希。
model ExternalAuthGrant {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  provider  String
  appId     String   @map("app_id")
  openId    String   @map("open_id")
  unionId   String?  @map("union_id")
  nickname  String?
  avatarUrl String?  @map("avatar_url")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("external_auth_grants")
}

// ============================================
// 2. 日记条目表
// ============================================
model DiaryEntry {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  title       String?
  content     String   @default("")
  diaryDate   String   @map("diary_date") // 格式: YYYY-MM-DD
  status      String   @default("active") // active | draft | trashed
  trashReason String?  @map("trash_reason") // deleted | abandoned
  trashedAt   DateTime? @map("trashed_at")
  isPinned    Boolean  @default(false) @map("is_pinned")
  isHidden    Boolean  @default(false) @map("is_hidden")
  mood        String?
  weather     String?
  tags        String?  // JSON 字符串: ["tag1", "tag2"]
  themeId     String?  @map("theme_id")
  images      String?  // JSON 字符串: ["url1", "url2"]
  dailyEcho   String?  @map("daily_echo") // JSON 字符串: 小象回声
  activeWritingSeconds Int @default(0) @map("active_writing_seconds")
  syncVersion Int      @default(0) @map("sync_version") // 乐观锁
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // 关联
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  histories EditHistory[]
  posts     CommunityPost[]
  dailyTraceNode DailyTraceNode?

  @@index([userId, status])
  @@index([userId, diaryDate])
  @@map("diary_entries")
}

// ============================================
// 3. 日记模板表
// ============================================
model DiaryTemplate {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id") // NULL = 系统模板
  title     String
  content   String
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("diary_templates")
}

// ============================================
// 4. 编辑历史表
// ============================================
model EditHistory {
  id      String   @id @default(uuid())
  entryId String   @map("entry_id")
  userId  String   @map("user_id")
  content String
  images  String?  // JSON 字符串
  summary String?
  savedAt DateTime @default(now()) @map("saved_at")

  entry DiaryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entryId, savedAt])
  @@map("edit_histories")
}

// ============================================
// 5. AI 聊天会话表
// ============================================
model ChatSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String?
  styleId   String?  @map("style_id")
  pinned    Boolean  @default(false)
  messages  String   @default("[]") // JSON 字符串: ChatMessage[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("chat_sessions")
}

// ============================================
// 6. 自定义字体表
// ============================================
model CustomFont {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  label      String
  fontFamily String   @map("font_family")
  fileUrl    String   @map("file_url")
  fileName   String?  @map("file_name")
  fileSize   Int?     @map("file_size")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("custom_fonts")
}

// ============================================
// 7. 社区帖子表
// ============================================
model CommunityPost {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  entryId   String?  @map("entry_id") // 关联的日记（可选）
  content   String
  images    String?  // JSON 字符串
  viewCount Int      @default(0) @map("view_count")
  readCount Int      @default(0) @map("read_count")
  status    String   @default("published") // published | hidden | deleted
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry    DiaryEntry?   @relation(fields: [entryId], references: [id], onDelete: SetNull)
  likes    PostLike[]
  comments PostComment[]

  @@index([createdAt])
  @@index([userId])
  @@map("community_posts")
}

// ============================================
// 8. 帖子点赞表
// ============================================
model PostLike {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId]) // 防止重复点赞
  @@map("post_likes")
}

// ============================================
// 9. 帖子评论表
// ============================================
model PostComment {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  content   String
  parentId  String?  @map("parent_id") // 楼中楼回复
  likes     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent PostComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies PostComment[] @relation("CommentReplies")
  likedBy PostCommentLike[]

  @@index([postId, createdAt])
  @@map("post_comments")
}

// ============================================
// 10. 评论点赞表
// ============================================
model PostCommentLike {
  id        String   @id @default(uuid())
  commentId String   @map("comment_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  comment PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId])
  @@map("post_comment_likes")
}

// ============================================
// 11. 好友关系表
// ============================================
model Friendship {
  id          String   @id @default(uuid())
  requesterId String  @map("requester_id")
  addresseeId String  @map("addressee_id")
  status      String  @default("pending") // pending | accepted | declined | blocked
  note        String? // 申请附言
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  requester User @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("Addressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@map("friendships")
}

// ============================================
// 11. 通知表
// ============================================
model Notification {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")     // 接收者
  fromUserId String?  @map("from_user_id") // 发送者
  type       String   // friend_request | like | comment | poke | system
  content    String?
  refPostId  String?  @map("ref_post_id")
  refDiaryId String?  @map("ref_diary_id")
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  receiver User  @relation("NotifReceiver", fields: [userId], references: [id], onDelete: Cascade)
  sender   User? @relation("NotifSender", fields: [fromUserId], references: [id], onDelete: SetNull)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

// ============================================
// 12. PWA Push 订阅表
// ============================================
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ============================================
// 13. 通知偏好表
// ============================================
model NotificationPreference {
  id                         String   @id @default(uuid())
  userId                     String   @unique @map("user_id")
  dailyReminderEnabled       Boolean  @default(false) @map("daily_reminder_enabled")
  dailyReminderTime          String   @default("21:00") @map("daily_reminder_time")
  dailyReminderTimezone      String   @default("Asia/Shanghai") @map("daily_reminder_timezone")
  lastDailyReminderDate      String?  @map("last_daily_reminder_date")
  monthlyEchoEnabled         Boolean  @default(true) @map("monthly_echo_enabled")
  monthlyEchoPushEnabled     Boolean  @default(true) @map("monthly_echo_push_enabled")
  monthlyEchoPushTime        String   @default("20:00") @map("monthly_echo_push_time")
  monthlyEchoTimezone        String   @default("Asia/Shanghai") @map("monthly_echo_timezone")
  socialNotifyEnabled        Boolean  @default(true) @map("social_notify_enabled")
  friendRequestNotifyEnabled Boolean  @default(true) @map("friend_request_notify_enabled")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ============================================
// 14. 自定义主题表（保留线上已有表，避免 db push 删除历史数据）
// ============================================
model CustomTheme {
  id        String   @id
  userId    String   @map("user_id")
  imageUrl  String   @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("custom_themes")
}

// ============================================
// 15. 排行榜点赞表
// ============================================
model LeaderboardLike {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")      // 被点赞人
  fromUserId String   @map("from_user_id") // 点赞人
  createdAt  DateTime @default(now()) @map("created_at")

  user     User @relation("ReceivedLeaderboardLikes", fields: [userId], references: [id], onDelete: Cascade)
  fromUser User @relation("GivenLeaderboardLikes", fields: [fromUserId], references: [id], onDelete: Cascade)

  @@unique([userId, fromUserId]) // 同一人对另一人只能点赞一次
  @@map("leaderboard_likes")
}

// ============================================
// 16. 月度回声：每日轨迹节点
// ============================================
model DailyTraceNode {
  id                   String    @id @default(uuid())
  userId               String    @map("user_id")
  entryId              String    @unique @map("entry_id")
  date                 String
  timezone             String    @default("Asia/Shanghai")
  monthKey             String    @map("month_key")
  sourceEntryCreatedAt DateTime? @map("source_entry_created_at")
  sourceEntryUpdatedAt DateTime  @map("source_entry_updated_at")
  sourceEntryHash      String    @map("source_entry_hash")
  importantEvents      String    @default("[]") @map("important_events")
  realActions          String    @default("[]") @map("real_actions")
  emotionStates        String    @default("[]") @map("emotion_states")
  relationshipSignals  String    @default("[]") @map("relationship_signals")
  energySources        String    @default("[]") @map("energy_sources")
  energyDrains         String    @default("[]") @map("energy_drains")
  repeatedTensions     String    @default("[]") @map("repeated_tensions")
  unfinishedQuestions  String    @default("[]") @map("unfinished_questions")
  changeSignals        String    @default("[]") @map("change_signals")
  evidenceQuotes       String    @default("[]") @map("evidence_quotes")
  tracePayload         String    @default("{}") @map("trace_payload")
  confidence           Float     @default(0)
  aiModel              String?   @map("ai_model")
  promptVersion        String    @default("daily_trace_v1") @map("prompt_version")
  status               String    @default("pending") // pending | generated | failed | stale | invalid
  errorMessage         String?   @map("error_message")
  generatedAt          DateTime? @map("generated_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry DiaryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([userId, entryId])
  @@index([userId, monthKey, status])
  @@map("daily_trace_nodes")
}

// ============================================
// 17. 月度回声：内部月度轨迹草稿
// ============================================
model MonthlyArcDraft {
  id                     String    @id @default(uuid())
  userId                 String    @map("user_id")
  monthKey               String    @map("month_key")
  timezone               String    @default("Asia/Shanghai")
  startDate              String    @map("start_date")
  endDate                String    @map("end_date")
  traceNodeIds           String    @default("[]") @map("trace_node_ids")
  entryCount             Int       @default(0) @map("entry_count")
  mainArc                String    @default("") @map("main_arc")
  keyEvents              String    @default("[]") @map("key_events")
  actionTrajectory       String    @default("") @map("action_trajectory")
  emotionTrajectory      String    @default("") @map("emotion_trajectory")
  repeatedTensions       String    @default("[]") @map("repeated_tensions")
  sideThemes             String    @default("[]") @map("side_themes")
  keyTurningPoint        String    @default("{}") @map("key_turning_point")
  hiddenNeed             String    @default("") @map("hidden_need")
  unfinishedQuestions    String    @default("[]") @map("unfinished_questions")
  growthDirection        String    @default("") @map("growth_direction")
  monthlyInsightSentence String    @default("") @map("monthly_insight_sentence")
  evidenceMap            String    @default("[]") @map("evidence_map")
  arcPayload              String    @default("{}") @map("arc_payload")
  confidence             Float     @default(0)
  aiModel                String?   @map("ai_model")
  promptVersion          String    @default("monthly_arc_v1") @map("prompt_version")
  status                 String    @default("pending") // pending | generated | failed | stale
  errorMessage           String?   @map("error_message")
  generatedAt            DateTime? @map("generated_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlyEcho MonthlyEcho?

  @@unique([userId, monthKey])
  @@index([userId, status])
  @@map("monthly_arc_drafts")
}

// ============================================
// 18. 月度回声：用户可见内容
// ============================================
model MonthlyEcho {
  id                       String    @id @default(uuid())
  userId                   String    @map("user_id")
  monthKey                 String    @map("month_key")
  monthlyArcDraftId        String?   @unique @map("monthly_arc_draft_id")
  title                    String    @default("")
  opening                  String    @default("")
  mainArcSection           String    @default("") @map("main_arc_section")
  keyMomentsSection        String    @default("") @map("key_moments_section")
  actionTrajectorySection  String    @default("") @map("action_trajectory_section")
  repeatedThemeSection     String    @default("") @map("repeated_theme_section")
  unfinishedSection        String    @default("") @map("unfinished_section")
  nextMonthQuestion        String    @default("") @map("next_month_question")
  finalInsightSentence     String    @default("") @map("final_insight_sentence")
  fullText                 String    @default("") @map("full_text")
  renderPayload            String    @default("{}") @map("render_payload")
  posterQuote              String?   @map("poster_quote")
  posterThemeLine          String?   @map("poster_theme_line")
  pushTitle                String?   @map("push_title")
  pushBody                 String?   @map("push_body")
  status                   String    @default("draft") // draft | ready | pushed | failed | stale
  pushedAt                 DateTime? @map("pushed_at")
  viewedAt                 DateTime? @map("viewed_at")
  firstGeneratedAt         DateTime? @map("first_generated_at")
  lastRegeneratedAt        DateTime? @map("last_regenerated_at")
  regenerateReason         String?   @map("regenerate_reason")
  aiModel                  String?   @map("ai_model")
  promptVersion            String    @default("monthly_echo_v1") @map("prompt_version")
  errorMessage             String?   @map("error_message")
  generatedAt              DateTime? @map("generated_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlyArcDraft MonthlyArcDraft? @relation(fields: [monthlyArcDraftId], references: [id], onDelete: SetNull)

  @@unique([userId, monthKey])
  @@index([userId, status])
  @@map("monthly_echoes")
}

// ============================================
// 19. 月度回声：轻量任务与运行锁
// ============================================
model MonthlyEchoJobLog {
  id                    String    @id @default(uuid())
  userId                String    @map("user_id")
  monthKey              String    @map("month_key")
  jobType               String    @map("job_type") // trace | monthly_arc | monthly_echo | month_end | backfill | regenerate
  status                String    @default("pending") // pending | running | success | failed | cancelled
  lockToken             String?   @map("lock_token")
  lockedUntil           DateTime? @map("locked_until")
  attemptCount          Int       @default(0) @map("attempt_count")
  totalEntries          Int       @default(0) @map("total_entries")
  generatedTraceNodes   Int       @default(0) @map("generated_trace_nodes")
  monthlyArcDraftStatus String?   @map("monthly_arc_draft_status")
  monthlyEchoStatus     String?   @map("monthly_echo_status")
  promptVersion         String    @default("") @map("prompt_version")
  lastError             String?   @map("last_error")
  startedAt             DateTime? @map("started_at")
  finishedAt            DateTime? @map("finished_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, monthKey, jobType])
  @@index([status, lockedUntil])
  @@map("monthly_echo_job_logs")
}

// ============================================
// 20. 每日回声：可恢复的后台生成任务
// ============================================
model DailyEchoJob {
  id                     String    @id @default(uuid())
  userId                 String    @map("user_id")
  entryId                String    @map("entry_id")
  activeKey              String?   @unique @map("active_key") // queued/running 时占用，终态释放
  runKey                 String?   @unique @map("run_key") // running 时按用户占用，限制单用户并发
  dedupeKey              String    @unique @map("dedupe_key")
  sourceHash             String    @map("source_hash")
  sourceEntryUpdatedAt   String    @map("source_entry_updated_at")
  regenerateCount        Int       @default(0) @map("regenerate_count")
  status                 String    @default("queued") // queued | running | succeeded | failed | stale
  promptInput            String?   @map("prompt_input") // 仅 queued/running 保留的 JSON 文本
  selectedMemoryEntryIds String    @default("[]") @map("selected_memory_entry_ids")
  previewContent         String    @default("") @map("preview_content")
  finalContent           String?   @map("final_content")
  promptVersion          String    @default("daily_echo_v1") @map("prompt_version")
  model                   String?
  provider                String?
  attemptCount            Int       @default(0) @map("attempt_count")
  lockToken               String?   @map("lock_token")
  lockedUntil             DateTime? @map("locked_until")
  errorCode               String?   @map("error_code")
  errorMessage            String?   @map("error_message")
  startedAt               DateTime? @map("started_at")
  finishedAt              DateTime? @map("finished_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, entryId, createdAt])
  @@index([status, lockedUntil])
  @@index([userId, updatedAt])
  @@map("daily_echo_jobs")
}
