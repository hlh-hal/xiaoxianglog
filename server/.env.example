# SQLite database
DATABASE_URL="file:./data/xiaoxiang.db"

# HTTP server
PORT="3001"

# OSS upload and backup storage
OSS_ENDPOINT="https://oss-cn-wuhan-lr.aliyuncs.com"
OSS_BUCKET="your-bucket-name"
OSS_ACCESS_KEY_ID="your-access-key-id"
OSS_ACCESS_KEY_SECRET="your-access-key-secret"
OSS_PUBLIC_BASE_URL="https://your-bucket-name.oss-cn-wuhan-lr.aliyuncs.com"

# Optional legacy local upload path
UPLOAD_DIR="./uploads"

# JWT
JWT_SECRET="change-me-in-production-32-chars-min"
JWT_REFRESH_SECRET="change-me-in-production-32-chars-min"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# Mail
MAIL_DEV_RETURN_CODE="false"
SMTP_HOST="smtp.qq.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-email@qq.com"
SMTP_PASS="your-smtp-auth-code"
MAIL_FROM="your-email@qq.com"
