# SQLite database
DATABASE_URL="file:./data/xiaoxiang.db"

# HTTP server
PORT="3001"

# Durable Daily Echo queue. Defaults to disabled in production unless explicitly enabled.
DAILY_ECHO_BACKGROUND_ENABLED="false"
DAILY_ECHO_SCHEDULER_INTERVAL_MS="5000"
DAILY_ECHO_RATE_LIMIT_PER_MINUTE="6"
DAILY_ECHO_MAX_WORKERS="4"
DAILY_ECHO_LOCK_MS="180000"
DAILY_ECHO_LOCK_RENEW_MS="30000"
DAILY_ECHO_JOB_TIMEOUT_MS="180000"

# OSS upload and backup storage
OSS_ENDPOINT="https://oss-cn-wuhan-lr.aliyuncs.com"
OSS_BUCKET="your-bucket-name"
OSS_ACCESS_KEY_ID="your-access-key-id"
OSS_ACCESS_KEY_SECRET="your-access-key-secret"
OSS_PUBLIC_BASE_URL="https://your-bucket-name.oss-cn-wuhan-lr.aliyuncs.com"

# Optional legacy local upload path
UPLOAD_DIR="./uploads"

# JWT
JWT_SECRET="change-me-in-production-32-chars-min"
JWT_REFRESH_SECRET="change-me-in-production-32-chars-min"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# PWA Web Push. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="replace-with-vapid-public-key"
VAPID_PRIVATE_KEY="replace-with-vapid-private-key"
VAPID_SUBJECT="mailto:admin@example.com"

# Mail
MAIL_DEV_RETURN_CODE="false"
SMTP_HOST="smtp.qq.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-email@qq.com"
SMTP_PASS="your-smtp-auth-code"
MAIL_FROM="your-email@qq.com"
