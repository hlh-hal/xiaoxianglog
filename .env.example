# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Frontend runtime configuration. For Android release builds, set this to your HTTPS API.
VITE_API_BASE_URL=https://api.example.com/api
VITE_AI_MODEL=xiaomi-mimo

# Backend AI proxy configuration
AI_API_KEY=replace-with-backend-only-key
AI_MODEL=xiaomi-mimo
XIAOMI_API_KEY=replace-with-backend-only-key
XIAOMI_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
CPAMC_API_KEY=replace-with-cpa-panel-key
CPAMC_BASE_URL=http://127.0.0.1:8317/v1
AI_PRIMARY_TIMEOUT_MS=45000
AI_THINKING_TIMEOUT_MS=120000
AI_MAX_USER_CONCURRENCY=1
AI_MAX_GLOBAL_CONCURRENCY=8

# Backend security configuration
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
APP_ORIGINS=capacitor://localhost,https://app.example.com

# Android WeChat login. Keep disabled until the WeChat Open Platform mobile app
# is approved for package com.xiaoxiang.diary and the production signing digest.
WECHAT_LOGIN_ENABLED=false
WECHAT_APP_ID=wx_replace_with_mobile_app_id
WECHAT_APP_SECRET=replace-with-server-only-app-secret

# PWA Web Push configuration. Generate a key pair with:
# cd server && npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_SUBJECT=mailto:admin@example.com

# Backend mail verification configuration.
# For local development, MAIL_DEV_RETURN_CODE=true lets the API return the code
# so the UI can display it without a real SMTP account.
MAIL_DEV_RETURN_CODE=true
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@qq.com
SMTP_PASS=your-smtp-authorization-code
MAIL_FROM=your-email@qq.com
